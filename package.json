{
  "name": "kashflow",
  "version": "1.0.0",
  "description": "Aplicación personal para registrar movimientos financieros via Telegram Bot con API REST y dashboard web",
  "private": true,
  "author": "Kevin",
  "license": "MIT",
  "main": "api/index.js",
  "packageManager": "pnpm@10.27.0",
  "engines": {
    "node": ">=18.0.0"
  },
  "scripts": {
    "dev": "node --watch api/index.js",
    "start": "node api/index.js",
    "test": "node --test tests/*.test.js",
    "dev:web": "vite",
    "build:web": "vue-tsc -b && vite build",
    "preview:web": "vite preview"
  },
  "keywords": [
    "telegram-bot",
    "finance",
    "expense-tracker",
    "api"
  ],
  "dependencies": {
    "better-sqlite3": "^11.8.1",
    "dotenv": "17.2.1",
    "express": "5.1.0",
    "node-telegram-bot-api": "0.66.0",
    "xlsx": "0.18.5"
  },
  "devDependencies": {
    "@lucide/vue": "^1.45.0",
    "@types/node": "^24.13.3",
    "@vitejs/plugin-vue": "^6.0.8",
    "@vue/tsconfig": "^0.9.1",
    "autoprefixer": "^10.6.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "pinia": "^4.0.3",
    "postcss": "^8.5.28",
    "reka-ui": "^2.10.4",
    "tailwind-merge": "^3.7.0",
    "tailwindcss": "^3.4.19",
    "typescript": "~6.0.2",
    "vite": "^8.3.0",
    "vite-plugin-pwa": "^1.3.0",
    "vue": "^3.5.42",
    "vue-router": "^5.3.1",
    "vue-tsc": "^3.3.11"
  }
}
